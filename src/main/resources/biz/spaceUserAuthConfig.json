      "description": "删除空间中的图片"
    },
    {
      "key": "post:view",
      "name": "查看帖子",
      "description": "查看空间中的帖子内容"
    },
    {
      "key": "post:upload",
      "name": "上传帖子",
      "description": "上传帖子到空间中"
    },
    {
      "key": "post:edit",
      "name": "修改帖子",
      "description": "编辑已上传的帖子信息"
    },
    {
      "key": "post:delete",
      "name": "删除帖子",
      "description": "删除空间中的帖子"
    }
  ],
  "roles": [
    {
      "key": "viewer",
      "name": "浏览者",
      "permissions": [
        "picture:view",
        "post:view"
      ],
      "description": "查看资源(帖子)"
    },
    {
      "key": "member",
      "name": "成员",
