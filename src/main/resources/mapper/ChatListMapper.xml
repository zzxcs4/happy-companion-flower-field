<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzx.yunpicturebackend.mapper.ChatListMapper">
    <select id="selectChat" resultType="com.zzx.flowerfieldfrienddisk.manager.websocket.model.ChatList">
        select * from chat_list where linkId = #{linkId} order by createtime asc;
    </select>

    <insert id="insertChat" keyProperty="listId" keyColumn="listId">
        insert into chat_list(linkId,userId,content,createtime,toId,isRead)
        values (#{linkId},#{fromId},#{content},#{timestamp},#{toId},0);
    </insert>

    <select id="selectUnreadConversations" resultType="com.zzx.flowerfieldfrienddisk.model.vo.UnreadChatVO">
        select userId, count(*) as unreadCount
        from chat_list
        where toId = #{toId} and isRead = 0
        group by userId;
    </select>

    <update id="markRead">
        update chat_list
        set isRead = 1
        where toId = #{toId} and userId = #{fromId} and isRead = 0;
    </update>
</mapper>
